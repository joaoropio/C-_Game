@implements IAsyncDisposable
@inject IJSRuntime Js
@inject UiText Ui

<div class="code-editor" @ref="host"></div>
@if (loadFailed)
{
    <p class="code-editor-error" role="alert">@Ui["editor.loadFailed"]</p>
}

@code {
    private readonly TaskCompletionSource<bool> ready = new(TaskCreationOptions.RunContinuationsAsynchronously);
    private ElementReference host;
    private IJSObjectReference? module;
    private int? editorId;
    private bool loadFailed;
    private bool disposed;

    [Parameter]
    public string InitialCode { get; set; } = "";

    public async Task<string> GetCodeAsync() =>
        await ready.Task && module is { } current ? await current.InvokeAsync<string>("getValue", editorId) : InitialCode;

    public async Task SetCodeAsync(string code)
    {
        if (await ready.Task && module is { } current)
        {
            await current.InvokeVoidAsync("setValue", editorId, code);
        }
    }

    public async Task InsertAsync(string text)
    {
        if (await ready.Task && module is { } current)
        {
            await current.InvokeVoidAsync("insert", editorId, text);
        }
    }

    public async Task ShowErrorsAsync(IReadOnlyList<CompilationError> errors)
    {
        var markers = errors
            .Where(error => error.Line is not null)
            .Select(error => new
            {
                Line = error.Line!.Value,
                Column = error.Column ?? 1,
                Message = error.Explanation?.Get(Ui.Language) ?? error.Message,
            })
            .ToList();
        await SetMarkersAsync(markers);
    }

    public Task ClearErrorsAsync() => SetMarkersAsync([]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var loaded = await Js.InvokeAsync<IJSObjectReference>("import", "./Components/CodeEditor.razor.js");
            var id = await loaded.InvokeAsync<int?>("create", host, InitialCode);
            if (id is null || disposed)
            {
                await ReleaseAsync(loaded, id);
                ready.TrySetResult(false);
                return;
            }

            module = loaded;
            editorId = id;
            ready.TrySetResult(true);
        }
        catch (JSException)
        {
            loadFailed = true;
            ready.TrySetResult(false);
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            ready.TrySetResult(false);
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        ready.TrySetResult(false);
        var released = module;
        var id = editorId;
        module = null;
        editorId = null;
        if (released is not null)
        {
            await ReleaseAsync(released, id);
        }
    }

    private async Task SetMarkersAsync(IReadOnlyList<object> markers)
    {
        if (await ready.Task && module is { } current)
        {
            await current.InvokeVoidAsync("setErrors", editorId, markers);
        }
    }

    private static async Task ReleaseAsync(IJSObjectReference target, int? id)
    {
        try
        {
            if (id is not null)
            {
                await target.InvokeVoidAsync("dispose", id);
            }

            await target.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
