@page "/level/{Id}"
@using CodeQuest.Core.Levels
@using CodeQuest.Core.Progress
@implements IDisposable
@inject GameContent Content
@inject UiText Ui
@inject ProgressStore Store
@inject ICodeRunner Runner
@inject NavigationManager Navigation

@if (level is not null && Store.Current is { } progress)
{
    <PageTitle>@level.Title.Get(Ui.Language)</PageTitle>

    <div class="page-content" inert="@(earnedStars is not null)">
        <div class="level-header">
            <a class="back-link" href="/" aria-label="@Ui["level.backToMap"]"><span aria-hidden="true">‹</span> @Ui["level.mapShort"]</a>
            <p class="crumb">@string.Format(Ui["level.crumb"], level.World, level.Number, Content.Levels.Count(candidate => candidate.World == level.World))</p>
        </div>
        <div class="level-layout">
            <section class="parchment">
                <figure class="vignette" role="img" aria-label="@level.SceneLabel.Get(Ui.Language)">
                    @((MarkupString)level.SceneSvg)
                </figure>
                <div class="parchment-body">
                    <h1>@level.Title.Get(Ui.Language)</h1>

                    <div class="tabs" role="tablist" aria-label="@Ui["level.tabs"]" @onkeydown="OnTabKeyDown">
                        @foreach (var tab in Tabs)
                        {
                            var index = (int)tab;
                            var key = tab.ToString().ToLowerInvariant();
                            <button type="button" role="tab" id="tab-@key" class="tab" @ref="tabButtons[index]"
                                    aria-selected="@Selected(tab)" tabindex="@(activeTab == tab ? 0 : -1)"
                                    aria-controls="panel-@key" @onclick="() => activeTab = tab">@TabLabel(tab)</button>
                        }
                    </div>

                    <div class="story tab-panel" role="tabpanel" id="panel-story" aria-labelledby="tab-story" hidden="@(activeTab != LevelTab.Story)">
                        <p>@level.Story.Get(Ui.Language)</p>
                    </div>
                    <div class="concept tab-panel" role="tabpanel" id="panel-concept" aria-labelledby="tab-concept" hidden="@(activeTab != LevelTab.Concept)">
                        <p>@level.Concept.Get(Ui.Language)</p>
                    </div>
                    <div class="hints-panel tab-panel" role="tabpanel" tabindex="-1" @ref="hintsPanel" id="panel-hints" aria-labelledby="tab-hints" hidden="@(activeTab != LevelTab.Hints)">
                        @if (hintsShown > 0)
                        {
                            <ol class="hints">
                                @foreach (var hint in level.Hints.Take(hintsShown))
                                {
                                    <li>@hint.Get(Ui.Language)</li>
                                }
                            </ol>
                        }
                        else
                        {
                            <p>@Ui["level.noHints"]</p>
                        }
                    </div>
                    <div class="hint-announcer visually-hidden" role="status" aria-live="polite">@announcedHint</div>
                </div>
            </section>

            <div class="right-column">
                <section class="spellbook" aria-labelledby="spellbook-title">
                    <div class="spellbook-head">
                        <h2 id="spellbook-title">@Ui["level.spellbook"]</h2>
                        <span class="language-tag" aria-hidden="true">C#</span>
                    </div>

                    <div class="editor-frame">
                        <CodeEditor @key="level.Id" @ref="editor" InitialCode="@level.StarterCode" />
                    </div>

                    <div class="actions">
                        <button type="button" class="run btn-primary" @ref="runButton" disabled="@running" @onclick="RunAsync">
                            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false"><path d="M9 1l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" fill="currentColor" /></svg>
                            @Ui[running ? "level.running" : "level.run"]
                        </button>
                        <button type="button" class="grimoire-open btn-secondary" @onclick="OpenGrimoire">@Ui["grimoire.open"]</button>
                        @if (hintsShown < level.Hints.Count)
                        {
                            <button type="button" class="hint btn-secondary" @onclick="ShowHintAsync">@Ui["level.hint"]</button>
                        }
                        @if (progress.CanSeeSolution(level.Id) && !progress.IsCompleted(level.Id))
                        {
                            <button type="button" class="solution btn-secondary" @onclick="ShowSolutionAsync">@Ui["level.solution"]</button>
                        }
                    </div>
                </section>

                @if (result is { } shown)
                {
                    <div class="result-block" tabindex="-1" @ref="resultBlock">
                        <RunResultView Result="shown" />
                    </div>
                }
            </div>
        </div>

        <GrimoirePanel IsOpen="grimoireOpen" InitialPageId="@level.GrimoirePageId"
                       OnClose="CloseGrimoire" OnCopyExample="InsertExampleAsync" />
    </div>

    @if (earnedStars is { } stars)
    {
        <div class="victory-backdrop">
            <section class="victory" role="dialog" aria-modal="true" aria-labelledby="victory-title"
                     tabindex="-1" @onkeydown="OnVictoryKeyDown">
                <svg class="victory-scene" viewBox="0 0 500 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
                    <defs>
                        <radialGradient id="victory-light" cx="50%" cy="60%" r="60%">
                            <stop offset="0%" stop-color="#ffe2a8" />
                            <stop offset="60%" stop-color="#f4c06a" stop-opacity="0.6" />
                            <stop offset="100%" stop-color="#f4c06a" stop-opacity="0" />
                        </radialGradient>
                    </defs>
                    <rect width="500" height="300" fill="#1a1510" />
                    <path d="M0 0H500M0 50H500M0 100H500M0 150H500M0 200H500M0 250H500M50 0V50M170 0V50M290 0V50M410 0V50M110 50V100M230 50V100M350 50V100M470 50V100M50 100V150M410 100V150M110 150V200M390 150V200M50 200V250M430 200V250" stroke="#2a221a" stroke-width="2" />
                    <path class="light-beam" d="M250 300 L120 300 L190 70 L310 70 L380 300 Z" fill="url(#victory-light)" opacity="0.6" />
                    <path class="door-opening" d="M165 300V140a85 85 0 0 1 170 0v160z" fill="#ffe2a8" />
                    <path class="door-frame" d="M165 300V140a85 85 0 0 1 170 0v160" fill="none" stroke="#c8913f" stroke-width="10" />
                    <path class="door-leaf door-leaf-left" d="M165 300V140 L120 120 V300 Z" fill="#5a4026" stroke="#3a2a17" stroke-width="2" />
                    <path class="door-leaf door-leaf-right" d="M335 300V140 L380 120 V300 Z" fill="#5a4026" stroke="#3a2a17" stroke-width="2" />
                    <path d="M128 150v120M372 150v120" stroke="#3a2a17" stroke-width="3" />
                    <g class="wizard">
                        <path d="M250 205 a14 14 0 1 1 0.1 0 M236 222 L264 222 L272 290 L228 290 Z M262 218 L292 182" fill="#2b1f14" stroke="#2b1f14" stroke-width="4" stroke-linejoin="round" />
                        <circle cx="294" cy="178" r="6" fill="#4fd1c5" />
                    </g>
                    <path class="sparkle" d="M80 80l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" fill="#f4c06a" />
                    <path class="sparkle" d="M420 60l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" fill="#f4c06a" />
                    <path class="sparkle" d="M430 190l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" fill="#f4c06a" />
                </svg>
                <h2 id="victory-title" class="victory-title">@Ui["level.doorOpen"]</h2>
                <p class="result-stars" role="img" aria-label="@string.Format(Ui["level.stars"], stars)">
                    @for (var star = 1; star <= 3; star++)
                    {
                        <svg class="star @(star <= stars ? "filled" : "") @(star == 2 ? "star-middle" : "")" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z" />
                        </svg>
                    }
                </p>
                @if (result is Passed passed)
                {
                    <p class="victory-summary">@(passed.StatementCount == 1 ? Ui["level.spellStatementsOne"] : string.Format(Ui["level.spellStatements"], passed.StatementCount))</p>
                }
                <div class="victory-actions">
                    <button type="button" class="next btn-primary" @ref="nextButton" @onclick="GoNext">@Ui[NextIsMap ? "level.backToMap" : "level.next"]</button>
                    <button type="button" class="stay btn-secondary" @onclick="CloseVictory">@Ui["level.stay"]</button>
                </div>
            </section>
        </div>
    }
}

@code {
    private enum LevelTab { Story, Concept, Hints }

    private CodeEditor? editor;
    private Level? level;
    private string? loadedId;
    private bool running;
    private bool grimoireOpen;
    private int hintsShown;
    private string announcedHint = "";
    private bool focusHintsPending;
    private ElementReference hintsPanel;
    private LevelTab activeTab = LevelTab.Story;
    private RunResult? result;
    private int? earnedStars;
    private bool focusVictoryPending;
    private bool focusResultPending;
    private bool focusRunPending;
    private ElementReference nextButton;
    private ElementReference runButton;
    private ElementReference resultBlock;
    private CancellationTokenSource? runCancellation;

    [Parameter]
    public string Id { get; set; } = "";

    private int NextIndex => Content.Levels.ToList().FindIndex(candidate => candidate.Id == Id) + 1;

    private bool NextIsMap => NextIndex >= Content.Levels.Count;

    private static readonly LevelTab[] Tabs = [LevelTab.Story, LevelTab.Concept, LevelTab.Hints];

    private readonly ElementReference[] tabButtons = new ElementReference[Tabs.Length];

    private string TabLabel(LevelTab tab) => tab switch
    {
        LevelTab.Story => Ui["level.story"],
        LevelTab.Concept => Ui["level.concept"],
        _ => hintsShown > 0 ? $"{Ui["level.hints"]} ({hintsShown})" : Ui["level.hints"],
    };

    private string Selected(LevelTab tab) => activeTab == tab ? "true" : "false";

    private string NextHref => NextIsMap ? "/" : $"/level/{Content.Levels[NextIndex].Id}";

    protected override void OnInitialized()
    {
        Ui.Changed += OnChanged;
        Store.Changed += OnStoreChanged;
    }

    protected override void OnParametersSet()
    {
        if (Id != loadedId)
        {
            loadedId = Id;
            CancelRun();
            hintsShown = 0;
            announcedHint = "";
            focusHintsPending = false;
            activeTab = LevelTab.Story;
            grimoireOpen = false;
            result = null;
            earnedStars = null;
            focusVictoryPending = false;
            focusResultPending = false;
            focusRunPending = false;
        }

        RedirectIfUnavailable();
    }

    public void Dispose()
    {
        runCancellation?.Cancel();
        Ui.Changed -= OnChanged;
        Store.Changed -= OnStoreChanged;
    }

    private void RedirectIfUnavailable()
    {
        level = Content.FindLevel(Id);
        var locked = Store.Current is { } progress && !progress.IsUnlocked(Content.Levels, Id);
        if (level is null || locked)
        {
            level = null;
            Navigation.NavigateTo("/");
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnStoreChanged() => _ = InvokeAsync(() =>
    {
        RedirectIfUnavailable();
        StateHasChanged();
    });

    private async Task RunAsync()
    {
        if (running || level is not { } current || editor is not { } activeEditor || Store.Current is not { } progress)
        {
            return;
        }

        using var cancellation = new CancellationTokenSource();
        runCancellation = cancellation;
        running = true;
        try
        {
            var code = await activeEditor.GetCodeAsync();
            var outcome = await Runner.RunAsync(new RunRequest(current.Template, code, current.ValidationSource), Ui.Language, cancellation.Token);
            if (!cancellation.IsCancellationRequested)
            {
                result = outcome;
                await ApplyResultAsync(current, progress, activeEditor, outcome);
                if (!cancellation.IsCancellationRequested)
                {
                    focusVictoryPending = outcome is Passed;
                    focusResultPending = outcome is not Passed;
                }
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(runCancellation, cancellation))
            {
                runCancellation = null;
                running = false;
            }
        }
    }

    private void CancelRun()
    {
        runCancellation?.Cancel();
        runCancellation = null;
        running = false;
    }

    private async Task ApplyResultAsync(Level current, PlayerProgress progress, CodeEditor activeEditor, RunResult outcome)
    {
        if (outcome is Passed passed)
        {
            var stars = StarCalculator.Calculate(
                current.World, passed.StatementCount, current.MaxStatementsForThreeStars, progress.UsedHint(current.Id), progress.SawSolution(current.Id));
            progress.RecordPass(current.Id, stars);
            earnedStars = progress.StarsFor(current.Id);
        }
        else
        {
            earnedStars = null;
            progress.RecordFailure(current.Id);
        }

        if (outcome is CompilationFailed failed)
        {
            await activeEditor.ShowErrorsAsync(failed.Errors);
        }
        else
        {
            await activeEditor.ClearErrorsAsync();
        }

        await Store.SaveAsync(progress);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusVictoryPending)
        {
            focusVictoryPending = false;
            await TryFocusAsync(nextButton);
        }
        else if (focusResultPending)
        {
            focusResultPending = false;
            await TryFocusAsync(resultBlock);
        }
        else if (focusHintsPending)
        {
            focusHintsPending = false;
            await TryFocusAsync(hintsPanel);
        }
        else if (focusRunPending)
        {
            focusRunPending = false;
            await TryFocusAsync(runButton);
        }
    }

    private static async Task TryFocusAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (JSException)
        {
            // The element was removed (level change, dialog closed) before the focus call arrived.
        }
    }

    private void GoNext() => Navigation.NavigateTo(NextHref);

    private void CloseVictory()
    {
        earnedStars = null;
        focusRunPending = true;
    }

    private void OnVictoryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseVictory();
        }
    }

    private async Task OnTabKeyDown(KeyboardEventArgs args)
    {
        // Focus always follows selection, so the focused tab is the selected one and the target comes from activeTab.
        var current = (int)activeTab;
        int? target = args.Key switch
        {
            "ArrowRight" => (current + 1) % Tabs.Length,
            "ArrowLeft" => (current + Tabs.Length - 1) % Tabs.Length,
            "Home" => 0,
            "End" => Tabs.Length - 1,
            _ => null,
        };
        if (target is { } index)
        {
            activeTab = Tabs[index];
            await TryFocusAsync(tabButtons[index]);
        }
    }

    private void OpenGrimoire() => grimoireOpen = true;

    private void CloseGrimoire() => grimoireOpen = false;

    private async Task InsertExampleAsync(string example)
    {
        if (editor is { } activeEditor)
        {
            await activeEditor.InsertAsync(example);
        }
    }

    private async Task ShowHintAsync()
    {
        if (level is null || Store.Current is not { } progress)
        {
            return;
        }

        hintsShown++;
        announcedHint = level.Hints[hintsShown - 1].Get(Ui.Language);
        focusHintsPending = hintsShown == level.Hints.Count;
        activeTab = LevelTab.Hints;
        progress.RecordHintUsed(level.Id);
        await Store.SaveAsync(progress);
    }

    private async Task ShowSolutionAsync()
    {
        if (level is null || editor is null || Store.Current is not { } progress)
        {
            return;
        }

        progress.RecordSolutionSeen(level.Id);
        await editor.SetCodeAsync(level.Solution);
        await Store.SaveAsync(progress);
    }
}
