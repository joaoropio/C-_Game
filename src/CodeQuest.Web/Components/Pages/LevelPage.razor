@page "/level/{Id}"
@using CodeQuest.Core.Levels
@using CodeQuest.Core.Progress
@implements IDisposable
@inject GameContent Content
@inject UiText Ui
@inject ProgressStore Store
@inject ICodeRunner Runner
@inject NavigationManager Navigation

@if (level is not null && Store.Current is { } progress)
{
    <PageTitle>@level.Title.Get(Ui.Language)</PageTitle>

    <div class="page-content" inert="@(earnedStars is not null)">
        <h1>@level.Title.Get(Ui.Language)</h1>

        <section class="story" aria-label="@Ui["level.story"]">
            <p>@level.Story.Get(Ui.Language)</p>
        </section>
        <section class="concept" aria-label="@Ui["level.concept"]">
            <p>@level.Concept.Get(Ui.Language)</p>
        </section>

        <div class="editor-frame">
            <CodeEditor @key="level.Id" @ref="editor" InitialCode="@level.StarterCode" />
        </div>

        <div class="actions">
            <button type="button" class="run" @ref="runButton" disabled="@running" @onclick="RunAsync">
                @Ui[running ? "level.running" : "level.run"]
            </button>
            <button type="button" class="grimoire-open" @onclick="OpenGrimoire">@Ui["grimoire.open"]</button>
            @if (hintsShown < level.Hints.Count)
            {
                <button type="button" class="hint" @onclick="ShowHintAsync">@Ui["level.hint"]</button>
            }
            @if (progress.CanSeeSolution(level.Id) && !progress.IsCompleted(level.Id))
            {
                <button type="button" class="solution" @onclick="ShowSolutionAsync">@Ui["level.solution"]</button>
            }
        </div>

        @if (hintsShown > 0)
        {
            <ol class="hints">
                @foreach (var hint in level.Hints.Take(hintsShown))
                {
                    <li>@hint.Get(Ui.Language)</li>
                }
            </ol>
        }

        @if (result is { } shown && shown is not Passed)
        {
            <div class="result-block" tabindex="-1" @ref="resultBlock">
                <RunResultView Result="shown" />
            </div>
        }

        <GrimoirePanel IsOpen="grimoireOpen" InitialPageId="@level.GrimoirePageId"
                       OnClose="CloseGrimoire" OnCopyExample="InsertExampleAsync" />
    </div>

    @if (earnedStars is { } stars)
    {
        <div class="victory-backdrop">
            <section class="victory" role="dialog" aria-modal="true" aria-labelledby="victory-title"
                     tabindex="-1" @onkeydown="OnVictoryKeyDown">
                <div class="scene" aria-hidden="true">
                    <div class="door open"><div class="door-leaf"></div></div>
                    <div class="hero"></div>
                </div>
                <h2 id="victory-title" class="passed">@Ui["level.passed"]</h2>
                <p class="result-stars" role="img" aria-label="@string.Format(Ui["level.stars"], stars)">
                    @for (var star = 1; star <= 3; star++)
                    {
                        <span class="star @(star <= stars ? "filled" : "")" aria-hidden="true">★</span>
                    }
                </p>
                <div class="victory-actions">
                    <button type="button" class="next" @ref="nextButton" @onclick="GoNext">@Ui[NextIsMap ? "level.backToMap" : "level.next"]</button>
                    <button type="button" class="stay" @onclick="CloseVictory">@Ui["level.stay"]</button>
                </div>
            </section>
        </div>
    }
}

@code {
    private CodeEditor? editor;
    private Level? level;
    private string? loadedId;
    private bool running;
    private bool grimoireOpen;
    private int hintsShown;
    private RunResult? result;
    private int? earnedStars;
    private bool focusVictoryPending;
    private bool focusResultPending;
    private bool focusRunPending;
    private ElementReference nextButton;
    private ElementReference runButton;
    private ElementReference resultBlock;
    private CancellationTokenSource? runCancellation;

    [Parameter]
    public string Id { get; set; } = "";

    private int NextIndex => Content.Levels.ToList().FindIndex(candidate => candidate.Id == Id) + 1;

    private bool NextIsMap => NextIndex >= Content.Levels.Count;

    private string NextHref => NextIsMap ? "/" : $"/level/{Content.Levels[NextIndex].Id}";

    protected override void OnInitialized()
    {
        Ui.Changed += OnChanged;
        Store.Changed += OnStoreChanged;
    }

    protected override void OnParametersSet()
    {
        if (Id != loadedId)
        {
            loadedId = Id;
            CancelRun();
            hintsShown = 0;
            grimoireOpen = false;
            result = null;
            earnedStars = null;
            focusVictoryPending = false;
            focusResultPending = false;
            focusRunPending = false;
        }

        RedirectIfUnavailable();
    }

    public void Dispose()
    {
        runCancellation?.Cancel();
        Ui.Changed -= OnChanged;
        Store.Changed -= OnStoreChanged;
    }

    private void RedirectIfUnavailable()
    {
        level = Content.FindLevel(Id);
        var locked = Store.Current is { } progress && !progress.IsUnlocked(Content.Levels, Id);
        if (level is null || locked)
        {
            level = null;
            Navigation.NavigateTo("/");
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnStoreChanged() => _ = InvokeAsync(() =>
    {
        RedirectIfUnavailable();
        StateHasChanged();
    });

    private async Task RunAsync()
    {
        if (running || level is not { } current || editor is not { } activeEditor || Store.Current is not { } progress)
        {
            return;
        }

        using var cancellation = new CancellationTokenSource();
        runCancellation = cancellation;
        running = true;
        try
        {
            var code = await activeEditor.GetCodeAsync();
            var outcome = await Runner.RunAsync(new RunRequest(current.Template, code, current.ValidationSource), Ui.Language, cancellation.Token);
            if (!cancellation.IsCancellationRequested)
            {
                result = outcome;
                await ApplyResultAsync(current, progress, activeEditor, outcome);
                if (!cancellation.IsCancellationRequested)
                {
                    focusVictoryPending = outcome is Passed;
                    focusResultPending = outcome is not Passed;
                }
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(runCancellation, cancellation))
            {
                runCancellation = null;
                running = false;
            }
        }
    }

    private void CancelRun()
    {
        runCancellation?.Cancel();
        runCancellation = null;
        running = false;
    }

    private async Task ApplyResultAsync(Level current, PlayerProgress progress, CodeEditor activeEditor, RunResult outcome)
    {
        if (outcome is Passed passed)
        {
            var stars = StarCalculator.Calculate(
                current.World, passed.StatementCount, current.MaxStatementsForThreeStars, progress.UsedHint(current.Id), progress.SawSolution(current.Id));
            progress.RecordPass(current.Id, stars);
            earnedStars = progress.StarsFor(current.Id);
        }
        else
        {
            earnedStars = null;
            progress.RecordFailure(current.Id);
        }

        if (outcome is CompilationFailed failed)
        {
            await activeEditor.ShowErrorsAsync(failed.Errors);
        }
        else
        {
            await activeEditor.ClearErrorsAsync();
        }

        await Store.SaveAsync(progress);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusVictoryPending)
        {
            focusVictoryPending = false;
            await TryFocusAsync(nextButton);
        }
        else if (focusResultPending)
        {
            focusResultPending = false;
            await TryFocusAsync(resultBlock);
        }
        else if (focusRunPending)
        {
            focusRunPending = false;
            await TryFocusAsync(runButton);
        }
    }

    private static async Task TryFocusAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (JSException)
        {
            // The element was removed (level change, dialog closed) before the focus call arrived.
        }
    }

    private void GoNext() => Navigation.NavigateTo(NextHref);

    private void CloseVictory()
    {
        earnedStars = null;
        focusRunPending = true;
    }

    private void OnVictoryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseVictory();
        }
    }

    private void OpenGrimoire() => grimoireOpen = true;

    private void CloseGrimoire() => grimoireOpen = false;

    private async Task InsertExampleAsync(string example)
    {
        if (editor is { } activeEditor)
        {
            await activeEditor.InsertAsync(example);
        }
    }

    private async Task ShowHintAsync()
    {
        if (level is null || Store.Current is not { } progress)
        {
            return;
        }

        hintsShown++;
        progress.RecordHintUsed(level.Id);
        await Store.SaveAsync(progress);
    }

    private async Task ShowSolutionAsync()
    {
        if (level is null || editor is null || Store.Current is not { } progress)
        {
            return;
        }

        progress.RecordSolutionSeen(level.Id);
        await editor.SetCodeAsync(level.Solution);
        await Store.SaveAsync(progress);
    }
}
