@page "/not-found"
@layout MainLayout
@implements IDisposable
@inject UiText Ui

<PageTitle>@Ui["notFound.title"]</PageTitle>

<h1>@Ui["notFound.title"]</h1>
<p>@Ui["notFound.message"]</p>

@code {
    protected override void OnInitialized() => Ui.Changed += OnChanged;

    public void Dispose() => Ui.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
