@page "/"
@implements IDisposable
@inject GameContent Content
@inject UiText Ui
@inject ProgressStore Store
@using System.Globalization

<PageTitle>@Ui["map.title"]</PageTitle>

<h1 class="visually-hidden">@Ui["map.title"]</h1>

@if (Store.Current is { } progress)
{
    var currentId = Content.Levels.FirstOrDefault(level => progress.IsUnlocked(Content.Levels, level.Id) && !progress.IsCompleted(level.Id))?.Id;
    foreach (var world in Content.Levels.GroupBy(level => level.World))
    {
        var levels = world.ToList();
        var floor = MapLayout.For(levels.Count);
        var starTotal = levels.Sum(level => progress.StarsFor(level.Id));
        var currentIndex = levels.FindIndex(level => level.Id == currentId);
        var trail = floor.Trail(currentIndex >= 0 ? currentIndex : levels.Count - 1);
        <section class="world" aria-labelledby="world-@world.Key">
            <header class="world-header">
                <div>
                    <p class="world-floor">@string.Format(Ui["map.floor"], world.Key)</p>
                    <h2 class="world-name" id="world-@world.Key">@Ui[$"map.world.{world.Key}"]</h2>
                </div>
                <p class="world-stars-total">
                    <svg class="world-star-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z" /></svg>
                    <span class="world-stars">@string.Format(Ui["map.stars"], starTotal, levels.Count * 3)</span>
                </p>
            </header>
            <div class="floor" style="--ratio: @floor.Width / @floor.Height; --w: @(floor.RoomWidthPercent.ToString("0.###", CultureInfo.InvariantCulture))%">
                <svg class="corridor" viewBox="0 0 @floor.Width @floor.Height" aria-hidden="true" focusable="false">
                    <defs>
                        <pattern id="stone-@world.Key" width="80" height="40" patternUnits="userSpaceOnUse">
                            <rect width="80" height="40" fill="#1b1713" />
                            <path d="M0 0H80M0 20H80M40 0V20M0 20V40M80 20V40" stroke="#241f19" stroke-width="2" />
                        </pattern>
                        <radialGradient id="torch-@world.Key" cx="50%" cy="50%" r="50%">
                            <stop offset="0%" stop-color="#e8a33d" stop-opacity="0.45" />
                            <stop offset="100%" stop-color="#e8a33d" stop-opacity="0" />
                        </radialGradient>
                    </defs>
                    <rect width="@floor.Width" height="@floor.Height" fill="url(#stone-@world.Key)" />
                    <path class="corridor-path" d="@floor.PathData" fill="none" stroke="#4a3e30" stroke-width="34" stroke-linecap="round" />
                    @if (trail.Length > 0)
                    {
                        <path class="trail" d="@trail" fill="none" stroke="#8a6a3e" stroke-width="6" stroke-dasharray="2 14" stroke-linecap="round" />
                    }
                    @if (currentIndex >= 0)
                    {
                        <circle class="torch-glow" cx="@floor.Rooms[currentIndex].X" cy="@floor.Rooms[currentIndex].Y" r="150" fill="url(#torch-@world.Key)" />
                    }
                </svg>
                <ol class="map">
                    @for (var index = 0; index < levels.Count; index++)
                    {
                        var level = levels[index];
                        var unlocked = progress.IsUnlocked(Content.Levels, level.Id);
                        var completed = progress.IsCompleted(level.Id);
                        var current = level.Id == currentId;
                        var stars = progress.StarsFor(level.Id);
                        var title = level.Title.Get(Ui.Language);
                        var state = !unlocked ? "locked" : current ? "current" : completed ? "done" : "open";
                        <li class="room @state" style="@floor.StyleOf(index)">
                            @if (!unlocked)
                            {
                                <svg class="door" viewBox="0 0 66 84" aria-hidden="true" focusable="false"><path d="M4 82V34a29 29 0 0 1 58 0v48z" fill="#211b15" stroke="#5a4a38" stroke-width="3" /><rect x="24" y="44" width="18" height="15" rx="2" fill="#5a4a38" /><path d="M27 44v-5a6 6 0 0 1 12 0v5" fill="none" stroke="#5a4a38" stroke-width="3" /></svg>
                            }
                            else if (current)
                            {
                                <svg class="door" viewBox="0 0 84 104" aria-hidden="true" focusable="false"><path d="M4 102V42a38 38 0 0 1 76 0v60z" fill="#3a2c1c" stroke="#f4c06a" stroke-width="4" /><path d="M16 102V46a26 26 0 0 1 52 0v56" fill="#f4c06a" fill-opacity="0.55" /><path d="M42 20v8M24 28l4 6M60 28l-4 6" stroke="#f4c06a" stroke-width="3" stroke-linecap="round" /></svg>
                            }
                            else
                            {
                                <svg class="door" viewBox="0 0 66 84" aria-hidden="true" focusable="false"><path d="M4 82V34a29 29 0 0 1 58 0v48z" fill="#2b231b" stroke="#c8913f" stroke-width="3" /><path d="M14 82V38a19 19 0 0 1 38 0v44" fill="#e8a33d" fill-opacity="0.25" /></svg>
                            }
                            <div class="room-body">
                                <span class="room-number">@level.World-@level.Number@if (current)
                                    {
                                        <span aria-hidden="true"> · @Ui["map.currentRoom"].ToLowerInvariant()</span>
                                    }</span>
                                @if (unlocked)
                                {
                                    <a class="room-title" href="/level/@level.Id">@title@if (current)
                                        {
                                            <span class="visually-hidden"> (@Ui["map.currentRoom"])</span>
                                        }</a>
                                    <span class="stars" role="img" aria-label="@string.Format(Ui["map.stars"], stars, 3)">
                                        @for (var star = 1; star <= 3; star++)
                                        {
                                            <span class="star @(star <= stars ? "filled" : "")" aria-hidden="true">★</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="room-title">@title</span>
                                    <span class="room-locked">@Ui["map.lockedRoom"]</span>
                                }
                            </div>
                        </li>
                    }
                </ol>
                @if (world.Key == Content.Levels.Max(level => level.World))
                {
                    <p class="next-world">
                        <svg viewBox="0 0 18 22" aria-hidden="true" focusable="false"><path d="M9 21V9M4 5l5-4 5 4" stroke="currentColor" stroke-width="2" fill="none" /></svg>
                        <span>@Ui["map.nextWorldSoon"]</span>
                    </p>
                }
            </div>
        </section>
    }
}

@code {
    protected override void OnInitialized()
    {
        Ui.Changed += OnChanged;
        Store.Changed += OnChanged;
    }

    public void Dispose()
    {
        Ui.Changed -= OnChanged;
        Store.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
