<svg class="page-icon" data-icon="@Kind" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Kind)
    {
        case "box":
            <path d="M3 8l9-4 9 4-9 4z" />
            <path d="M3 8v8l9 4 9-4V8" />
            <path d="M12 12v8" />
            break;
        case "scales":
            <path d="M12 4v16M7 20h10M5 7h14" />
            <path d="M5 7l-3 7a3 3 0 0 0 6 0zM19 7l-3 7a3 3 0 0 0 6 0z" />
            break;
        case "fork":
            <circle cx="12" cy="5" r="2" />
            <circle cx="6" cy="19" r="2" />
            <circle cx="18" cy="19" r="2" />
            <path d="M12 7v4M12 11c0 3-6 3-6 6M12 11c0 3 6 3 6 6" />
            break;
        case "hourglass":
            <path d="M6 3h12M6 21h12" />
            <path d="M7 3c0 6 5 6 5 9s-5 3-5 9M17 3c0 6-5 6-5 9s5 3 5 9" />
            break;
        case "shelf":
            <path d="M3 12h18M3 21h18" />
            <path d="M6 12V9h3v3M7 9V6h1v3M12 12V8h3v4M13 8V5h1v3M17 21v-4h3v4M18 17v-3h1v3" />
            break;
        case "quill":
            <path d="M20 4C12 4 7 9 7 16l-3 4" />
            <path d="M20 4c0 8-5 13-13 12" />
            <path d="M9 14l7-7" />
            break;
        case "tome":
            <path d="M12 6C9 4 5 4 3 5v13c2-1 6-1 9 1 3-2 7-2 9-1V5c-2-1-6-1-9 1z" />
            <path d="M12 6v13M16 9l1 2 2 .5-2 .5-1 2-1-2-2-.5 2-.5z" />
            break;
        case "fireballs":
            <circle cx="9" cy="14" r="6" />
            <circle cx="18" cy="7" r="3" />
            <path d="M9 11c2 2 2 4 0 6-2-2-2-4 0-6zM18 5.5c1 1 1 2 0 3-1-1-1-2 0-3z" />
            break;
        case "backpack":
            <path d="M8 7a4 4 0 0 1 8 0M7 7h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z" />
            <path d="M8 14h8v5H8zM8 14c0-2 8-2 8 0" />
            break;
        case "flask":
            <path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3" />
            <path d="M7.5 15h9M12 12v.01" />
            break;
        case "cabinet":
            <path d="M4 3h16v18H4zM4 12h16M12 3v18" />
            <path d="M8 7.5h.01M16 7.5h.01M8 16.5h.01M16 16.5h.01" />
            break;
        case "golem":
            <path d="M8 3h8l1 4v3H7V7z" />
            <path d="M5 10h14v6h-3v5h-3v-5h-2v5H8v-5H5z" />
            <path d="M10 6h.01M14 6h.01M12 12v3" />
            break;
        case "dragon":
            <path d="M4 20c0-6 3-9 7-10l2-4 2 3 5 1-1 3-4 1c0 4-2 6-5 6z" />
            <path d="M13 6l1-3M16 7l2-2M15.5 9h.01" />
            break;
        case "masks":
            <path d="M3 5h10v6a5 5 0 0 1-10 0z" />
            <path d="M5.5 8h.01M10.5 8h.01M5.5 12c1.5 1 3.5 1 5 0" />
            <path d="M13 9h8v6a5 5 0 0 1-8 4" />
            <path d="M15.5 12h.01M19 12h.01M15.5 16c1.2-1 2.8-1 4 0" />
            break;
        case "griffin":
            <path d="M12 21v-6M12 15c-2-3-6-3-9-9 4 0 7 1 9 4 2-3 5-4 9-4-3 6-7 6-9 9z" />
            <path d="M12 10V6l-1-2M12 6l1-2M12 8h.01" />
            break;
        case "slime":
            <path d="M5 19c-2-7 2-12 7-12s9 5 7 12c0 1-3 2-7 2s-7-1-7-2z" />
            <path d="M9.5 14h.01M14.5 14h.01M10 17c1.2.8 2.8.8 4 0" />
            break;
        default:
            <path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z" />
            <path d="M4 21V5M9 8h6" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string PageId { get; set; } = "";

    private string Kind => PageId switch
    {
        "variables" => "box",
        "operators" => "scales",
        "conditions" => "fork",
        "loops" => "hourglass",
        "arrays" => "shelf",
        "strings" => "quill",
        "methods" => "tome",
        "overloads" => "fireballs",
        "exceptions" => "flask",
        "lists" => "backpack",
        "dictionaries" => "cabinet",
        "classes" => "slime",
        "constructors" => "golem",
        "inheritance" => "dragon",
        "polymorphism" => "masks",
        "abstract-interfaces" => "griffin",
        _ => "book",
    };
}
