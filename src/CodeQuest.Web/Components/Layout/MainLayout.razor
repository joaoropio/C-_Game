@inherits LayoutComponentBase
@implements IDisposable
@inject UiText Ui
@inject ProgressStore Progress

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/">@Ui["app.title"]</a>
        <LanguageSwitcher />
    </header>

    @if (Progress.WasUnreadable && !_warningDismissed)
    {
        <div class="notice" role="alert">
            <p>@Ui["progress.unreadable"]</p>
            <button type="button" @onclick="() => _warningDismissed = true">@Ui["progress.dismiss"]</button>
        </div>
    }

    <main>@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Ui["error.unhandled"]
    <a href="." class="reload">@Ui["error.reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _warningDismissed;

    protected override void OnInitialized()
    {
        Ui.Changed += OnChanged;
        Progress.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Ui.LoadAsync();
            await Progress.LoadAsync();
        }
    }

    public void Dispose()
    {
        Ui.Changed -= OnChanged;
        Progress.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
