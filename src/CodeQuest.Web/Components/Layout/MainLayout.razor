@inherits LayoutComponentBase
@implements IDisposable
@inject UiText Ui
@inject ProgressStore Progress

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/">
            <svg class="brand-mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" focusable="false"><path d="M17 3 L29 10 L29 24 L17 31 L5 24 L5 10 Z" fill="none" stroke="#e8a33d" stroke-width="2" /><path d="M17 9 L17 25 M11 13 L23 21 M23 13 L11 21" stroke="#4fd1c5" stroke-width="1.6" /></svg>
            <span>@Ui["app.title"]</span>
        </a>
        <LanguageSwitcher />
    </header>

    @if (Progress.WasUnreadable && !_warningDismissed)
    {
        <div class="notice" role="alert">
            <p>@Ui["progress.unreadable"]</p>
            <button type="button" @onclick="() => _warningDismissed = true">@Ui["progress.dismiss"]</button>
        </div>
    }

    <main>@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Ui["error.unhandled"]
    <a href="." class="reload">@Ui["error.reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _warningDismissed;

    protected override void OnInitialized()
    {
        Ui.Changed += OnChanged;
        Progress.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Ui.LoadAsync();
            await Progress.LoadAsync();
        }
    }

    public void Dispose()
    {
        Ui.Changed -= OnChanged;
        Progress.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
