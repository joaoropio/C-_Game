@inherits LayoutComponentBase
@implements IDisposable
@inject UiText Ui
@inject ProgressStore Progress

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/">@Ui["app.title"]</a>
        <LanguageSwitcher />
    </header>

    @if (Progress.WasUnreadable)
    {
        <p class="notice" role="alert">@Ui["progress.unreadable"]</p>
    }

    <main>@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Ui.Changed += OnChanged;
        Progress.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Ui.LoadAsync();
            await Progress.LoadAsync();
        }
    }

    public void Dispose()
    {
        Ui.Changed -= OnChanged;
        Progress.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}