<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            A religar ao servidor...<br />
            <span lang="en">Rejoining the server...</span>
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Falha ao religar... segundos até à próxima tentativa:
            <span lang="en">Rejoin failed... seconds until the next attempt:</span>
            <span id="components-seconds-to-next-attempt"></span>
        </p>
        <p class="components-reconnect-failed-visible">
            Falha ao religar. Tenta de novo ou recarrega a página.<br />
            <span lang="en">Failed to rejoin. Please retry or reload the page.</span>
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            Tentar de novo / <span lang="en">Retry</span>
        </button>
        <p class="components-pause-visible">
            O servidor pôs a sessão em pausa.<br />
            <span lang="en">The session has been paused by the server.</span>
        </p>
        <p class="components-resume-failed-visible">
            Falha ao retomar a sessão. Tenta de novo ou recarrega a página.<br />
            <span lang="en">Failed to resume the session. Please retry or reload the page.</span>
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            Retomar / <span lang="en">Resume</span>
        </button>
    </div>
</dialog>
